KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_RAW_TOPIC=raw_social_posts
KAFKA_PROCESSED_TOPIC=processed_sentiments
KAFKA_ADVERTISED_HOST_NAME=localhost
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SSL_CA_LOCATION=

ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=sentiment_results
ELASTICSEARCH_BATCH_SIZE=100

COLLECTOR_SOURCE=reddit
COLLECTOR_MODE=local
COLLECTOR_LAMBDA_FUNCTION_NAME=reddit-collector-to-kafka
COLLECTOR_LAMBDA_REGION=eu-north-1

DEFAULT_EVENT_NAME=Morocco football
DEFAULT_REDDIT_KEYWORDS=morocco football,Morocco match,CAN Morocco
DEFAULT_REDDIT_SUBREDDITS=soccer,worldcup
DEFAULT_REDDIT_SORT_MODE=relevance
DEFAULT_REDDIT_TIME_FILTER=
REDDIT_SCRAPER_ENGINE=requests
REDDIT_MAX_POSTS=20
REDDIT_MAX_COMMENTS_PER_POST=50
REDDIT_REQUEST_DELAY_SECONDS=2
REDDIT_TIMEOUT_SECONDS=15
REDDIT_HEADLESS=true
REDDIT_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.0.0 Safari/537.36

MODEL_PROVIDER=huggingface
MODEL_NAME=cardiffnlp/twitter-xlm-roberta-base-sentiment
MODEL_VERSION=v1
MODEL_DEVICE=cpu

SPARK_APP_NAME=SocialMediaSentimentStreaming
SPARK_MASTER=local[*]
SPARK_CHECKPOINT_DIR=checkpoints/spark
SPARK_OUTPUT_MODE=both
SPARK_MAX_OFFSETS_PER_TRIGGER=10

AWS_REGION=us-east-1
S3_BUCKET_NAME=your_bucket_name
S3_PREFIX=raw/reddit
ENABLE_S3_BACKUP=true
