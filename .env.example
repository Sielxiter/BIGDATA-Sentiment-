KAFKA_BOOTSTRAP_SERVERS=13.48.181.188:29092
KAFKA_RAW_TOPIC=raw_social_posts
KAFKA_PROCESSED_TOPIC=processed_sentiments
KAFKA_ADVERTISED_HOST_NAME=13.48.181.188
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SSL_CA_LOCATION=

ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=sentiment_results
ELASTICSEARCH_BATCH_SIZE=100

COLLECTOR_SOURCE=youtube
COLLECTOR_MODE=local
COLLECTOR_LAMBDA_FUNCTION_NAME=youtube-collector-to-kafka
COLLECTOR_LAMBDA_REGION=eu-north-1

DEFAULT_EVENT_NAME=Morocco football
DEFAULT_YOUTUBE_SEARCH_QUERIES=morocco football,Morocco match,CAN Morocco
DEFAULT_YOUTUBE_VIDEO_IDS=
DEFAULT_YOUTUBE_CHANNEL_IDS=
DEFAULT_YOUTUBE_ORDER=relevance
DEFAULT_YOUTUBE_REGION_CODE=
DEFAULT_YOUTUBE_RELEVANCE_LANGUAGE=en
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_API_BASE_URL=https://www.googleapis.com/youtube/v3
YOUTUBE_MAX_VIDEOS=20
YOUTUBE_MAX_COMMENTS_PER_VIDEO=50
YOUTUBE_REQUEST_DELAY_SECONDS=0.25
YOUTUBE_API_TIMEOUT_SECONDS=20
YOUTUBE_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.0.0 Safari/537.36
YOUTUBE_PUBLISHED_AFTER=
YOUTUBE_PUBLISHED_BEFORE=

MODEL_PROVIDER=huggingface
MODEL_NAME=cardiffnlp/twitter-xlm-roberta-base-sentiment
MODEL_VERSION=v1
MODEL_DEVICE=cpu

SPARK_APP_NAME=SocialMediaSentimentStreaming
SPARK_MASTER=local[*]
SPARK_CHECKPOINT_DIR=checkpoints/spark
SPARK_OUTPUT_MODE=both
SPARK_MAX_OFFSETS_PER_TRIGGER=10

AWS_REGION=us-east-1
S3_BUCKET_NAME=your_bucket_name
S3_PREFIX=raw/youtube
ENABLE_S3_BACKUP=true
COLLECTOR_CONFIG_BUCKET_NAME=your_bucket_name
COLLECTOR_CONFIG_S3_KEY=config/youtube_collector_runtime.json
COLLECTOR_STATE_BUCKET_NAME=your_bucket_name
COLLECTOR_STATE_S3_KEY=state/youtube_collector_state.json
COLLECTOR_STATE_MAX_COMMENT_IDS=5000
