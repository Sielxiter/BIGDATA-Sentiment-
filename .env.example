KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_RAW_TOPIC=raw_social_posts
KAFKA_PROCESSED_TOPIC=processed_sentiments

ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=sentiment_results

# Optional later: Reddit API collector is kept for future use.
REDDIT_CLIENT_ID=your_client_id
REDDIT_CLIENT_SECRET=your_client_secret
REDDIT_USER_AGENT=sentiment-bigdata-platform/1.0

YOUTUBE_API_KEY=your_youtube_api_key
DEFAULT_EVENT_NAME=Morocco football
DEFAULT_YOUTUBE_KEYWORDS=Morocco football,Morocco match,CAN Morocco
DEFAULT_YOUTUBE_MAX_VIDEOS=5
DEFAULT_YOUTUBE_MAX_COMMENTS=50

# Optional later defaults for the Reddit collector.
DEFAULT_REDDIT_KEYWORDS=Morocco football,Morocco match,CAN Morocco
DEFAULT_REDDIT_LIMIT=20

MODEL_PROVIDER=huggingface
MODEL_NAME=cardiffnlp/twitter-xlm-roberta-base-sentiment
MODEL_VERSION=v1
MODEL_DEVICE=cpu

SPARK_APP_NAME=SocialMediaSentimentStreaming
SPARK_MASTER=local[*]
SPARK_CHECKPOINT_DIR=checkpoints/spark

STREAMLIT_REFRESH_SECONDS=5
